// RJL Capital Advisors CRM - data model v1
// Multi-select fields are stored as JSON string arrays (SQLite has no array type).
// Switching to Postgres later only requires changing the datasource provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // migrations and db push bypass the pooler
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  active    Boolean  @default(true)
  signatureHtml String? // Outlook signature, pasted in Settings or picked up from a sent email
  workspaces    String   @default("[]") // JSON: ["CA"], ["IL"] or both; empty means the sign-in email decides
  israelEmail   String?  // the person's @rjlisrael.com mailbox, read into RJL Israel once that tenant is connected
  mailReads     String?  // JSON: which side reads each mailbox, set under Users > Email reading: "CA" or "AQ" for the RJL CA address (never both), "IL" for the Israel address; null = the default from their access
  acqMailSyncedAt   DateTime? // RJL Acquisitions: this person's mailbox last read into that side
  israelMailSyncedAt DateTime? // last RJL Israel mailbox pass for israelEmail
  mailSyncedAt  DateTime? // last time this mailbox was read into the email log
  invitedAt     DateTime? // when the invite email last went out (Settings > Users)
  lastSignInAt  DateTime? // last Microsoft sign-in
  createdAt DateTime @default(now())

  companies Company[]
  contacts  Contact[]
  deals     Deal[]
}

model Company {
  id            String   @id @default(cuid())
  hubspotId     String?  @unique
  name          String
  roles         String   @default("[]") // JSON: Sponsor | Investor | Retail Investor | Lender | Broker
  domain        String?  // email domain (citivestinc.com); contacts with this domain belong here
  website       String?
  description   String?  // one or two sentences pulled from their website
  phone         String?
  linkedin      String?
  enrichedAt    DateTime? // last time we read their website
  streetAddress String?
  city          String?
  state         String?
  yearFounded   Int?
  notes         String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  criteria   InvestorCriteria?
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  partyOf       ActivityParty[]

  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
  @@index([state])
  @@index([domain])
}

model Contact {
  id            String   @id @default(cuid())
  hubspotId     String?  @unique
  firstName     String?
  lastName      String?
  email         String?  @unique
  phone         String?
  title         String?
  roles         String   @default("[]")
  accredited    Boolean?
  streetAddress String?
  notes         String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  marketingContact Boolean @default(false)
  unsubscribed     Boolean @default(false)
  departedAt       DateTime? // left the firm (auto-reply / bounce said so, Jonathan approved the removal)
  bounceReason     String?

  criteria   InvestorCriteria?
  activities Activity[]
  partyOf          ActivityParty[]
  recipients CampaignRecipient[]
  dealRows   DealInvestor[]

  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lastName, firstName])
  @@index([companyId])
}

// LP / capital-source criteria. Lives on the Company; a Contact may carry an override.
model InvestorCriteria {
  id String @id @default(cuid())

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?  @unique
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assetClasses    String  @default("[]") // JSON array
  checkSizes      String  @default("[]")
  dealSizes       String  @default("[]")
  investmentTypes String  @default("[]") // JV Equity, Co-GP Equity, Preferred Equity, Senior Debt, Mezz Debt
  strategy        String? // Development | Acquisitions | Both
  geographies     String  @default("[]") // normalized region / state tags
  geographyNotes  String? // original free text
  vintages        String  @default("[]")
  returnProfile   String  @default("[]") // Core, Core+, Light value-add, Heavy value-add, Opportunistic
  holdPeriods     String  @default("[]") // 1-3, 3-5, 5-7, 7-10, 10+ years (derived from holdMin/holdMax)
  checkMinMM      Int?    // $MM, 1..100 (100 = $100MM+)
  checkMaxMM      Int?
  holdMinYears    Int?    // 1..10 (10 = 10+ years)
  holdMaxYears    Int?
  vintageMin      Int?    // 1950 = older than 1960, 1960..2025 in 5s, 9999 = new construction
  vintageMax      Int?
  ozInterest      Boolean?
  closingTimeframe String? // Fast | Average | Slow
  openToMinority  Boolean?
  otherInfo       String?
  openToFunds     Boolean?
  lenderPricing   String?
  aum             String?
  unitsManaged    String?

  updatedAt DateTime @updatedAt
}

model Deal {
  id        String  @id @default(cuid())
  hubspotId String? @unique
  name      String
  stage     String  @default("Deal Received")
  position  Int     @default(0)
  staleCheckedAt DateTime?
  staleHandledAt DateTime? // Handle on a quiet deal; leaves Data updates once the check-in goes out
  staleHandledBy String?
  reportInactiveAt DateTime? // Not active on the Active progress reports page; back when an investor row changes after it
  parentDealId String?  // a component of a portfolio deal: off the board, its data and files serve the portfolio
  parent       Deal?    @relation("Portfolio", fields: [parentDealId], references: [id])
  children     Deal[]   @relation("Portfolio")
  reportSentAt   DateTime? // the progress report last went to the sponsor
  reportDraftId  String?   // Outlook draft of the report email, watched until it goes
  reportDraftMailbox String?
  reportDraftAt  DateTime? // Jonathan chose Keep on the Data updates culling list; the deal hides there for a few more quiet days

  sponsorName      String?
  sponsorCompanyId String?
  sponsorCompany   Company? @relation(fields: [sponsorCompanyId], references: [id])

  propertyName    String?
  propertyAddress String?
  city            String?
  state           String?
  assetClass      String?
  strategy        String? // Development | Acquisitions
  onMarket        Boolean?

  requestType     String? // Equity | Debt | Both
  requestedAmount Float?
  totalEquity     Float?
  purchasePrice   Float?
  ltv             Float?
  loanTerm        String?
  equityMultiple  Float?
  occupancy       Float?
  sponsorExperience String?
  summary         String?
  details         String  @default("{}") // JSON: checklist answers keyed by src/lib/checklist.ts item key

  // Underwriting snapshot (from HubSpot deal properties)
  executionType       String? // JV Equity | LP Equity | Co-GP Equity | Preferred Equity | Senior Debt | Mezz Debt
  totalDebt           Float?
  totalCapitalization Float?
  ltc                 Float?
  interestRate        String?
  amortization        String? // I/O and amortization structure, e.g. "2 years I/O followed by 30 year amortization"
  lenderType          String?
  irr                 Float?
  holdPeriod          String?
  yieldOnCost         Float?
  capRateY1           Float?
  capRateT12          Float?
  cashOnCash          Float?
  projectedReturns    String?
  units               Int?
  squareFeet          Float?
  yearBuilt           String?
  unitMix             String?
  expectedClose       String?
  closedLostReason    String?
  closedWonReason     String?

  // Progress report (tracker) header fields
  trackerPreparedFor  String? // e.g. sponsor contact the report is for
  trackerThemes       String? // notable feedback themes across investor responses
  trackerItemsNote    String? // extra "items needed from sponsor" beyond the checklist
  trackerSummaryAt    DateTime? // themes/items last written; a newer note on any row means they are stale
  trackerSummaryKey String?   // what the themes and items were last written from (row notes, statuses, open asks); unchanged means no rewrite
  trackerManualAt     DateTime? // themes/items last edited by hand on the tracker page; the writer keeps that text and only adjusts it

  closeDate DateTime?
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id])

  activities Activity[]
  campaigns  Campaign[]
  investors  DealInvestor[]
  actions    DealAction[]

  createdAt DateTime @default(now())
  emails    DealEmail[]
  files     DealFile[]
  facts     DealFact[]
  updatedAt DateTime @updatedAt

  @@index([stage])
}

// Investor progress tracker row for a deal (mirrors the legacy Google Drive progress report).
model DealInvestor {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id])
  status    Int       @default(1) // 1 Deal Not Sent .. 8 Pass (see src/lib/tracker.ts)
  note      String?
  noteDate  DateTime?
  followUpDraftId String?   // Outlook draft created by "Respond now"; the row flips to Followed Up once it is sent
  followUpDraftAt DateTime?
  followUpDismissedAt DateTime? // taken off the LP follow-ups window by hand (deal given up on, or not worth chasing)
  followUpMailbox String?   // whose mailbox holds that draft
  openingLine     String?   // personal first line for the deal email to this person
  bodyOverride    String?   // full custom body for this person (optional)
  extraContactIds String?   // JSON: other people at the firm also on the To line
  sendDraftId     String?   // Outlook draft of the deal email; row flips to Deal Sent once it is sent
  sendMailbox     String?
  sendDraftAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([dealId, contactId])
  @@index([dealId, status])
}

model DealAction {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id         String   @id @default(cuid())
  type       String // EMAIL | CALL | MEETING | NOTE
  subject    String?
  body       String?
  direction  String? // OUTBOUND | INBOUND
  occurredAt DateTime @default(now())
  externalId String?  @unique // internet message id / Fireflies transcript id
  meta       String?  // JSON: { from: {name,email}, to: [{name,email}], cc: [...], mailbox, hasAttachments }

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  parties   ActivityParty[] // everyone else on the email (the other recipients, the CCs)

  createdAt DateTime @default(now())

  @@index([contactId, occurredAt])
  @@index([dealId, occurredAt])
}

/// The other people on an email: an Activity carries one primary contact; every other external person on it is a
/// party, so the email shows on each of their pages and their companies' pages, and Last activity moves for all.
model ActivityParty {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  role       String   @default("to") // from | to | cc

  @@unique([activityId, contactId])
  @@index([contactId])
  @@index([companyId])
}

// Mail-merge templates. Merge fields use {{deal.propertyName}}, {{contact.firstName}}, etc.
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("DEAL") // DEAL (one-to-one deal outreach) | BLAST (marketing blast)
  workspace String   @default("CA") // CA | IL: which business's pages offer it
  subject   String
  bodyHtml  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

model Campaign {
  id         String   @id @default(cuid())
  name       String
  mode       String   @default("OUTREACH") // OUTREACH (one at a time, personalized) | BLAST (send all at once)
  followUp   Boolean  @default(false) // follow-up round: sending moves tracker rows to "Followed Up"
  status     String   @default("DRAFT") // DRAFT | SENDING | SENT | PARTIAL
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id])
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id])
  // Snapshot of the template at campaign creation so later edits do not change what was sent
  subject    String
  bodyHtml   String
  roleFilter String? // Investor | Sponsor | ...
  minScore   Int      @default(0)
  fromName   String?
  replyTo    String?
  segment    String? // JSON { audience: Investor | Sponsor | All, assetClasses: [] }
  scheduledAt DateTime? // when a scheduled blast goes out
  followUpDays String? // "3,7": resend to anyone quiet after these many days
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id])
  status       String   @default("PENDING") // PENDING | SENT | FAILED | OPENED | CLICKED | BOUNCED | UNSUBSCRIBED
  matchScore   Int      @default(0)
  matchReasons String   @default("[]") // JSON array of strings
  openingLine  String?  // per-recipient personal opener, merged via {{openingLine}}
  bodyOverride String?  // full custom body for this recipient (optional)
  sentVia      String?  // resend | outlook | manual
  providerId   String?
  error        String?
  sentAt       DateTime?
  openedAt     DateTime?

  repliedAt  DateTime?
  lastSentAt DateTime? // last email in the sequence (first send or a follow-up)
  followUpsSent Int    @default(0)
  nextFollowUpAt DateTime?

  @@unique([campaignId, contactId])
  @@index([nextFollowUpAt])
}

// Proposed criteria changes from Fireflies calls or emails. Applied only when approved.
model CriteriaProposal {
  id         String   @id @default(cuid())
  source     String // FIREFLIES | EMAIL | MANUAL
  sourceRef  String? // transcript id / message id
  companyId  String?
  contactId  String?
  dealId     String?  // naming-convention renames
  summary    String
  changes    String // JSON: [{ field, from, to, evidence }]
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
}

// A forwarded deal email awaiting review. Extracted fields become a Deal once approved.
model DealIntake {
  id          String   @id @default(cuid())
  source      String   @default("PASTE") // PASTE | WEBHOOK
  fromEmail   String?
  fromName    String?
  toEmail     String?
  subject     String?
  rawText     String
  attachments String   @default("[]") // JSON array of file names
  extracted   String   @default("{}") // JSON: extracted deal fields
  missing     String   @default("[]") // JSON array of missing item keys
  notes       String?  // extractor commentary / confidence notes
  extractor   String?  // claude | heuristic
  status      String   @default("PENDING") // PENDING | CONVERTED | DISMISSED
  messageId   String?  @unique // Internet Message-ID of the forwarded email (deals@ mailbox), so it is processed once
  dealId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Manual to-do items on the dashboard (system-derived items are computed live, not stored).
model Todo {
  id        String    @id @default(cuid())
  text      String
  link      String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
}

/// Deal momentum: situations where a deal is waiting on someone (sponsor items, intro scheduling, call action items).
model Momentum {
  id            String   @id @default(cuid())
  dealId        String
  kind          String // SPONSOR_ITEMS | INTRO | ACTION
  party         String // who we are waiting on, e.g. "MORVAY (David Rottenberg)"
  companyId     String?
  contactId     String?
  summary       String // one line: what is outstanding
  waitingSince  DateTime
  lastMessageId String? // Internet Message-ID of the latest email in that thread (Handle replies to it)
  refMessageId  String? // SPONSOR_ANSWER: the sponsor's email that carries the answers (quoted, files carried over)
  status        String   @default("OPEN") // OPEN | DONE | DISMISSED
  handledAt     DateTime? // Handle clicked; the item closes once an email to the party goes out
  handledBy     String?   // whose mailbox to watch
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([dealId, kind, party])
}

/// Intros we made by email ("Intro - Company A | Company B") and whether the thread went anywhere.
model Intro {
  id             String   @id @default(cuid())
  mailbox        String // whose Sent Items it came from
  subject        String
  partyA         String?
  partyB         String?
  recipients     String   @default("[]") // JSON: email addresses on the intro
  conversationId String?
  messageId      String   @unique // Internet Message-ID of the intro email
  introducedAt   DateTime
  lastActivityAt DateTime
  lastMessageId  String? // Internet Message-ID of the latest message in the thread (Handle replies to it)
  replies        Int      @default(0) // messages in the thread after the intro
  handledAt      DateTime? // Handle was clicked; disappears once a reply to the parties shows up in Sent Items
  status         String   @default("OPEN") // OPEN | DISMISSED | DONE
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lastActivityAt])
}

/// Email threads already read for deal mentions (so each thread state is only sent to Claude once).
model MentionScan {
  externalId String   @id // Internet Message-ID of the newest message in the thread when read
  companyId  String?
  scannedAt  DateTime @default(now())
}

/// Inbound LP emails already read for requests (each email is sent to Claude once).
/// Required Items Lists: what the deals mailbox asks a sponsor for (RJL CA, by strategy and asset class) and what a
/// complete RJL Israel ticket carries (projects, apartments, houses). Edited on the Required Items Lists pages.
model RequiredItem {
  id           String   @id @default(cuid())
  workspace    String   // CA | IL
  category     String   // CA: deal. IL: projects | apartments | houses
  key          String   // the ticket field it fills, or x_<slug> for a question with no field of its own
  label        String
  devLabel     String?  // CA: wording on a development
  question     String?  // how it is asked / what Claude looks for
  kind         String   @default("text") // short | text | number | yesno | doc
  strategies   String   @default("[]") // CA: JSON list of Acquisitions and/or Development
  assetClasses String?  // CA: JSON list; null means every asset class
  core         String?  // CA: the Deal column the answer lives in
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspace, category, key])
  @@index([workspace, category, sortOrder])
}

/// Required Items Lists as windows: one bulleted list each, with a heading saying what it is for (RJL CA: Acquisitions or
/// Development plus asset classes; RJL Israel: apartments or houses). The default windows cover whatever has no window.
/// Key/value settings edited in the CRM. underwritingRules: the house rules the deals@ extractor reads (one per line).
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model RequiredList {
  id           String   @id @default(cuid())
  workspace    String   // CA | IL
  kind         String   // CA: Acquisitions | Development. IL: apartments | houses | projects
  assetClasses String?  // CA: JSON list of the asset classes this window is for; null on the defaults
  isDefault    Boolean  @default(false)
  text         String   @default("") // one item per line
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspace, sortOrder])
}

/// Sponsor emails already read for answers to LP questions (each once).
model SponsorAnswerScan {
  externalId String   @id
  result     String?
  scannedAt  DateTime @default(now())
}

model LpAskScan {
  externalId String   @id
  result     String?
  scannedAt  DateTime @default(now())
}

/// Every email that reached deals@ about a deal: the original intake and every follow-up (threads are matched on conversationId).
model DealEmail {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messageId      String   @unique // Internet Message-ID
  graphId        String? // id in the deals@ mailbox
  conversationId String?
  subject        String?
  fromEmail      String?
  receivedAt     DateTime @default(now())
  kind           String   @default("FOLLOWUP") // INTAKE | FOLLOWUP
  createdAt      DateTime @default(now())

  @@index([dealId, receivedAt])
  @@index([conversationId])
}

/// Files the sponsor sent on a deal, wherever they arrived; the ticket's Attachments window and the Send deal picker read this.
model DealFile {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name         String
  size         Int      @default(0)
  contentType  String?
  mailbox      String // where the bytes live (deals@)
  graphId      String // message id in that mailbox
  attachmentId String
  url          String?  // a Drive / Dropbox / OneDrive link the file was pulled from (bytes re-fetched from there)
  fromEmail    String?
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([graphId, attachmentId])
  @@index([dealId, receivedAt])
}

/// Things the sponsor has told us about a deal (Q&A). Grows with every follow-up; used to answer LP questions.
model DealFact {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  source    String? // email subject / date it came from
  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
  inFaq     Boolean  @default(false) // on the Investor FAQ: only questions somebody actually asked and the sponsor answered
}

// Ask the CRM conversations, per person, so a chat survives leaving the page.
model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  workspace String        @default("CA") // CA (RJL Capital Advisors) | IL (RJL Israel)
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, workspace, updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  lookups   String? // JSON list of the lookups behind an answer
  data      String? // JSON: attachments (parsed spreadsheets) on a user turn, an import proposal and its importedAt on an assistant turn, rules saved
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// ---------- RJL Israel: apartments and the people around them (kept apart from RJL Capital Advisors) ----------
model IlApartment {
  id             String    @id @default(cuid())
  name           String
  stage          String    @default("Apartment Received")
  apartmentType  String?
  degem          String?   // the unit type code on a developer's plans (UA1, D, PH4); the name is the project's
  city           String?
  neighborhood   String?
  street         String?
  projectName    String?
  projectId      String?
  project        IlProject? @relation(fields: [projectId], references: [id])
  rooms          Float?
  floor          Int?
  totalFloors    Int?
  internalSqm    Float?
  mirpesetSqm    Float?
  gardenSqm      Float?
  direction      String    @default("[]") // JSON list of air directions
  parking        Int?
  parkingSpots   String?   // None, 1, 2 - back to back, 2 side by side, 3
  ceilingCm      Float?
  machsanSqm     Float?
  machsanLocation String?  // Attached to apartment, In basement
  mirpesetDirection String @default("[]") // JSON list of air directions (union of the mirpasot)
  mirpesetCount  Int?
  mirpasot       String    @default("[]") // JSON list of { sqm, direction[] } when there is more than one mirpeset
  levels         Int?      // floors inside the apartment: 1, 2 (duplex) or 3
  ceilingCms     String    @default("[]") // one ceiling height per level when levels > 1
  buildingUnits  Int?
  floorplan      Bytes?
  floorplanType  String?
  floorplanName  String?
  sourceMessageId String?  // the email to deals@rjlisrael this ticket came from
  storage        Boolean   @default(false)
  elevator       Boolean   @default(false)
  mamad          Boolean?  // Yes, No, or not stated yet (asked for while null)
  priceNis       Float?
  priceCheckedAt DateTime? // pricing last confirmed with the agent or developer; the dashboard asks again after 90 days
  pendingApproval Boolean  @default(false) // came in by email with data missing; sits in The Que until approved
  approvalRequestedAt DateTime? // someone approved it from The Que with data still missing; Jonathan decides on the dashboard
  approvalRequestedBy String?
  extra          String?   // JSON answers to Required Items List questions that have no field of their own
  pool           String?   // Private pool: Yes | No
  poolSqm        Float?
  lat            Float?    // the pin for the address, looked up once per address
  lng            Float?
  geoQuery       String?   // the address the pin was looked up from
  geoLabel       String?   // what it resolved to, and how precisely
  photos         IlPhoto[]
  sellerType     String?   // Yad Rishona (developer), Second hand, never occupied, Second hand, occupied
  renovationYear Int?
  builtYear      Int?
  completionDate String?
  condition      String?
  description    String?
  source         String?
  developerId    String?
  developer      IlCompany? @relation(fields: [developerId], references: [id])
  agentContactId String?
  agent          IlContact? @relation("IlAgent", fields: [agentContactId], references: [id])
  sellerContactId String?
  seller         IlContact? @relation("IlSeller", fields: [sellerContactId], references: [id])
  notes          IlNote[]
  deals          IlDeal[]
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage, updatedAt])
  @@index([city])
}

model IlCompany {
  id         String        @id @default(cuid())
  name       String
  roles      String        @default("[]") // JSON list: Sponsor (Yazam), Kablan, Broker, Buyer, Attorneys, Mortgage Broker, Other
  sponsorFocus String?     // Development | Acquisitions | Both, when the company is a sponsor
  city       String?
  website    String?
  domain     String?       // email domain, set when the company is created or matched from an email
  phone      String?
  notes      String?
  lastActivityAt DateTime?
  activities IlActivity[]
  contacts   IlContact[]
  apartments IlApartment[]
  houses     IlHouse[]
  projects   IlProject[]
  ilNotes    IlNote[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model IlContact {
  id           String        @id @default(cuid())
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  roles        String        @default("[]") // JSON list
  language     String?
  budgetMinNis Float?
  budgetMaxNis Float?
  wantsCities  String?
  wantsRooms   String?
  notes        String?
  companyId    String?
  company      IlCompany?    @relation(fields: [companyId], references: [id])
  agentOf      IlApartment[] @relation("IlAgent")
  projectAgentOf IlProject[]  @relation("IlProjectAgent")
  sellerOf     IlApartment[] @relation("IlSeller")
  houseAgentOf  IlHouse[]    @relation("IlHouseAgent")
  houseSellerOf IlHouse[]    @relation("IlHouseSeller")
  buyerDeals   IlDeal[]      @relation("IlDealBuyer")
  agentDeals   IlDeal[]      @relation("IlDealAgent")
  ilNotes      IlNote[]
  activities   IlActivity[]
  lastActivityAt DateTime?
  unsubscribed Boolean       @default(false) // asked off the RJL Israel email blasts
  blastRows    IlCampaignRecipient[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([lastName, firstName])
  @@index([email])
}

model IlNote {
  id          String       @id @default(cuid())
  body        String
  apartmentId String?
  apartment   IlApartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  houseId     String?
  house       IlHouse?     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     IlContact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     IlCompany?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        IlDeal?      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  projectId   String?
  project     IlProject?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([apartmentId, createdAt])
}

// RJL Israel pipeline: a buyer pursuing an apartment, moving through the funnel
/// Renderings and photos of a unit or project: above the floorplan on the ticket, attachable to the send-out.
model IlPhoto {
  id          String       @id @default(cuid())
  name        String
  type        String
  bytes       Bytes
  apartmentId String?
  apartment   IlApartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  houseId     String?
  house       IlHouse?     @relation(fields: [houseId], references: [id], onDelete: Cascade)
  projectId   String?
  project     IlProject?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([apartmentId])
  @@index([houseId])
  @@index([projectId])
}

model IlDeal {
  id             String       @id @default(cuid())
  name           String
  stage          String       @default("Lead")
  apartmentId    String?
  apartment      IlApartment? @relation(fields: [apartmentId], references: [id])
  buyerContactId String?
  buyer          IlContact?   @relation("IlDealBuyer", fields: [buyerContactId], references: [id])
  agentContactId String?
  agent          IlContact?   @relation("IlDealAgent", fields: [agentContactId], references: [id])
  offerNis       Float?
  agreedPriceNis Float?
  expectedClose  String?
  lostReason     String?
  snoozedUntil   DateTime?    // Deals mentioned: off the dashboard until then
  description    String?
  notes          IlNote[]
  activities     IlActivity[]
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([stage, updatedAt])
}

// RJL Israel: a whole project (building or development), the apartments inside it hang off it
model IlProject {
  id             String        @id @default(cuid())
  name           String
  developerId    String?
  developer      IlCompany?    @relation(fields: [developerId], references: [id])
  street         String?
  city           String?
  neighborhood   String?
  totalUnits     Int?
  parkingSpaces  Int?
  stories        Int?
  completionDate String?
  description    String?
  extra          String?       // JSON answers to Required Items List questions that have no field of their own
  doorman        String?       // Doorman in the building: Yes | No (kept in step with amenities)
  amenities      String?       // JSON list: Doorman | Pool | Gym | Jacuzzi | Sauna | Yoga/Pilates Studio | Co-working spaces (Sep 23, 2026)
  pool           String?       // Project pool (shared): Yes | No
  gym            String?       // Gym in the project: Yes | No
  agentContactId String?       // the broker who brought the project
  agent          IlContact?    @relation("IlProjectAgent", fields: [agentContactId], references: [id])
  priceCheckedAt DateTime?     // unit pricing last confirmed with the developer; asked again after 90 days
  pendingApproval Boolean      @default(false) // came in with data missing; sits in The Que until approved
  approvalRequestedAt DateTime?
  approvalRequestedBy String?
  lat            Float?
  lng            Float?
  geoQuery       String?
  geoLabel       String?
  photos         IlPhoto[]
  brochure       Bytes?
  brochureType   String?
  brochureName   String?
  apartments     IlApartment[]
  houses         IlHouse[]
  notes          IlNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([city])
}

// Emails handled from the RJL Israel deals mailbox, each once
model IlInbound {
  id           String   @id @default(cuid())
  messageId    String   @unique
  mailbox      String
  subject      String?
  fromEmail    String?
  result       String
  pendingReply String?  // the reply that failed to send (HTML); the next inbox pass sends it and clears this
  graphId      String?  // the message in the Israel mailbox, for that retry
  createdAt    DateTime @default(now())
}

// LAUNCH queue: one deal email per firm, sent one every 30 seconds from the sender mailbox (src/lib/launch-queue.ts)
model DealLaunch {
  id           String    @id @default(cuid())
  dealId       String
  rowId        String
  mailbox      String
  toContactIds String    // JSON contact ids
  cc           String    // JSON emails
  subject      String
  html         String
  fileKeys     String?   // JSON keys of the chosen attachments; null = everything the sponsor sent
  status       String    @default("QUEUED") // QUEUED | SENDING | SENT | FAILED
  error        String?
  notBefore    DateTime? // held back until then (Microsoft throttled the attachment upload); null = ready
  attempts     Int       @default(0)
  claimedAt    DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([mailbox, status])
  @@index([dealId, createdAt])
}

// Two tickets Jonathan said are NOT the same deal; Possible duplicates stops pairing them
model DealNotDuplicate {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  createdAt DateTime @default(now())

  @@unique([aId, bId])
}

// WhatsApp messages to the RJL Israel number, one row per message; a burst from one sender is handled as one listing
model WaInbound {
  id         String    @id @default(cuid())
  messageId  String    @unique
  waId       String
  senderName String?
  number     String
  type       String
  payload    String
  receivedAt DateTime
  handledAt  DateTime?
  result     String?
  createdAt  DateTime  @default(now())

  @@index([waId, handledAt])
}

// RJL Israel email log: one row per email read from an RJL Israel mailbox that involves someone outside the company
model IlActivity {
  id         String   @id @default(cuid())
  type       String   @default("EMAIL")
  subject    String?
  body       String?
  direction  String? // OUTBOUND | INBOUND
  occurredAt DateTime @default(now())
  externalId String?  @unique // internet message id
  meta       String? // JSON: { from, to, cc, mailbox, hasAttachments }
  contactId  String?
  contact    IlContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String?
  company    IlCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       IlDeal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([dealId, occurredAt])
}

/// RJL Israel email blasts: one email to a group of Israel contacts, through Resend, each send logged on the contact.
model IlCampaign {
  id         String   @id @default(cuid())
  name       String
  status     String   @default("DRAFT") // DRAFT | SENDING | SENT | PARTIAL
  subject    String
  bodyHtml   String
  segment    String   @default("{}") // JSON { roles: [], city }
  templateId String?
  replyTo    String?
  sentAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipients IlCampaignRecipient[]
}

model IlCampaignRecipient {
  id         String     @id @default(cuid())
  campaignId String
  campaign   IlCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    IlContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String     @default("PENDING") // PENDING | SENT | FAILED | SKIPPED | UNSUBSCRIBED
  providerId String?
  error      String?
  sentAt     DateTime?

  @@unique([campaignId, contactId])
}

// Last pass per RJL Israel shared mailbox (deals@); people's mailboxes keep theirs on User
model IlSyncState {
  mailbox  String   @id
  syncedAt DateTime
}

// RJL Israel: a house (cottage, villa) with a plot, its own floors and a ceiling height per floor
model IlHouse {
  id              String    @id @default(cuid())
  name            String
  houseType       String?   // Villa, Semi-attached, Cottage
  degem           String?   // the unit type code on a developer's plans
  projectId       String?
  project         IlProject? @relation(fields: [projectId], references: [id])
  city            String?
  neighborhood    String?
  street          String?
  rooms           Float?
  floors          Int?      // miflasim
  ceilingCms      String    @default("[]") // JSON list, one entry per floor, ground floor first
  completionDate  String?
  internalSqm     Float?
  mirpesetSqm     Float?    // total of the mirpasot
  mirpesetCount   Int?
  mirpesetDirection String  @default("[]")
  mirpasot        String    @default("[]") // JSON list of { sqm, direction[] }
  migrashSqm      Float?    // the plot
  pool            String?   // Yes | No
  poolSqm         Float?
  priceCheckedAt  DateTime? // pricing last confirmed; asked again after 90 days
  pendingApproval Boolean   @default(false) // came in by email or WhatsApp with data missing; sits in The Que until approved
  approvalRequestedAt DateTime? // approved from The Que with data still missing; Jonathan decides on the dashboard
  approvalRequestedBy String?
  extra           String?   // JSON answers to Required Items List questions that have no field of their own
  lat             Float?
  lng             Float?
  geoQuery        String?
  geoLabel        String?
  photos          IlPhoto[]
  source          String?
  sourceMessageId String?
  floorplan       Bytes?
  floorplanType   String?
  floorplanName   String?
  parkingSpots    String?
  sellerType      String?
  renovationYear  Int?
  mamad           Boolean?  // Yes, No, or not stated yet
  priceNis        Float?
  description     String?
  developerId     String?
  developer       IlCompany? @relation(fields: [developerId], references: [id])
  agentContactId  String?
  agent           IlContact? @relation("IlHouseAgent", fields: [agentContactId], references: [id])
  sellerContactId String?
  seller          IlContact? @relation("IlHouseSeller", fields: [sellerContactId], references: [id])
  notes           IlNote[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([city])
}


// ---------- RJL Acquisitions (Shawn's CRM, Sep 18, 2026): sellers, operators and buyers around properties ----------
model AqCompany {
  id             String   @id @default(cuid())
  name           String
  roles          String   @default("[]") // JSON list: Seller | Operator | Buyer; flows to every contact at the company
  city           String?
  state          String?
  website        String?
  domain         String?  // email domain, set when the company is created or matched from an email
  phone          String?
  notes          String?
  lastActivityAt DateTime?
  contacts       AqContact[]
  activities     AqActivity[]
  aqNotes        AqNote[]
  properties     AqPropertyCompany[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
model AqContact {
  id             String   @id @default(cuid())
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  roles          String   @default("[]") // JSON list: Owner | Operator | Buyer
  notes          String?
  companyId      String?
  company        AqCompany? @relation(fields: [companyId], references: [id])
  // the contact card carries every way to reach the person (Sep 22, 2026; moved here from the property ticket)
  secondaryPhone String?
  otherPhones    String?  // one per line
  emails         String?  // other emails, one per line
  mailingAddress String?
  // operator details, shown only when the role Operator is on
  operatorBrandName     String?
  website               String?
  operatorEntityName    String?
  directoryOperatorName String?
  storePhone            String?  // the store's public number (Google)
  directoryOperatorPhone String?
  operatorTotalLocations Int?
  operatorPipelineStatus String?  // Pipeline | Corporate | Not interested
  // the call, tracked per person: result, callback target (the dashboard's Call Me Back), follow-up
  lastCallDate        DateTime?
  callResult          String?  // Deal | Callback | Not interested | No answer | Wrong number
  callBackAt          DateTime?
  callBackDismissedAt DateTime?
  followUpAt          DateTime?
  activities     AqActivity[]
  aqNotes        AqNote[]
  transcripts    AqTranscript[]
  properties     AqPropertyContact[]
  lastActivityAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([email])
}
model AqProperty {
  id                  String   @id @default(cuid())
  address             String
  neighborhood        String?
  city                String?
  state               String?
  county              String?
  stages              String   @default("[]") // JSON list, the Call Result: Deal | Callback | Not interested | No answer | Wrong number
  callBackAt          DateTime? // the Callback target date; the dashboard's Call Me Back window shows the property from that day (followUpAt when set) until dismissed
  callBackDismissedAt DateTime?
  followUpAt          DateTime? // Follow Up Date: mirrors the callback target unless typed over
  lastCallDate        DateTime?
  callNotes           String?
  dealStage           String?  // pipeline column while Deal is ticked (Setting aqDealStages)
  businessName        String?  // the business operating at the property today
  assetType           String?  // Free-standing | Strip center | Other
  parcelId            String?
  ownerEntity         String?  // the entity on title, usually an LLC
  ownerName           String?  // the person behind it
  primaryPhone        String?
  secondaryPhone      String?
  otherPhones         String?  // one per line
  primaryEmail        String?
  emails              String?  // from public record, one per line
  ownerMailingAddress String?
  ownerContactId      String?  // the contact ticket made from the owner fields (kept in step by syncPropertyPeople)
  operatorEntity      String?  // the business operating at the property, as a company
  operatorName        String?  // the person running it
  operatorPhone       String?
  operatorSecondaryPhone String?
  operatorOtherPhones String?  // one per line
  operatorEmail       String?
  operatorEmails      String?  // one per line
  operatorMailingAddress String?
  operatorContactId   String?  // the contact ticket made from the operator fields
  acreage             Float?
  squareFeet          Int?     // gross SF
  yearBuilt           Int?
  lastSaleDate        DateTime?
  lastSalePrice       Float?
  askingPrice         Float?
  units               Int?
  notes               String?
  lat                 Float?   // map pin for the address (Nominatim, looked up once per address)
  lng                 Float?
  geoQuery            String?
  geoLabel            String?
  companies           AqPropertyCompany[]
  contacts            AqPropertyContact[]
  aqNotes             AqNote[]
  transcripts         AqTranscript[]
  activities          AqActivity[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([city, state])
  @@index([callBackAt])
}
/** A call transcript pasted onto a property. The newest sits on top of the ticket's Transcript card. */
model AqTranscript {
  id         String      @id @default(cuid())
  propertyId String?
  property   AqProperty? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    AqContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime    @default(now())

  @@index([propertyId, createdAt])
  @@index([contactId, createdAt])
}

model AqPropertyCompany {
  propertyId String
  property   AqProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  companyId  String
  company    AqCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@id([propertyId, companyId])
}
model AqPropertyContact {
  propertyId String
  property   AqProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactId  String
  contact    AqContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@id([propertyId, contactId])
}
model AqNote {
  id         String      @id @default(cuid())
  body       String
  contactId  String?
  contact    AqContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String?
  company    AqCompany?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId String?
  property   AqProperty? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
}
model AqActivity {
  id         String      @id @default(cuid())
  type       String      @default("EMAIL")
  subject    String?
  body       String?
  direction  String?     // OUTBOUND | INBOUND
  occurredAt DateTime    @default(now())
  externalId String?     @unique // internet message id
  meta       String?     // JSON: { from, to, cc, mailbox, hasAttachments }
  contactId  String?
  contact    AqContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId  String?
  company    AqCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  propertyId String?
  property   AqProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([contactId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([propertyId, occurredAt])
}

/// A team member's to-do, made from an email they forwarded to deals@ with a note like "remind me to handle" (Sep 22, 2026). Dismissed once done, gone from the dashboard for good.
model Reminder {
  id        String    @id @default(cuid())
  userEmail String    // who forwarded it; the item shows on their dashboard
  text      String    // one or two lines: what to handle and who is in the email
  people    String?   // JSON: the names (and firms) found in the email
  subject   String?
  messageId String?   @unique
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userEmail, doneAt, createdAt])
}

/// A progress report row someone removed (Sep 22, 2026): everything needed to put it back with Undo, kept 30 days.
model TrackerRemoval {
  id              String   @id @default(cuid())
  dealId          String
  contactId       String
  status          Int
  note            String?
  noteDate        DateTime?
  openingLine     String?
  bodyOverride    String?
  extraContactIds String?
  removedBy       String?
  removedAt       DateTime @default(now())

  @@index([dealId, removedAt])
}
